n = 4
x = [0] * (n + 1)


def abs_value(r):
    return abs(r)


def queen_place(k, i):
    for j in range(1, k):
        if x[j] == i or abs_value(x[j] - i) == abs_value(j - k):
            return False
    return True


def n_queen(k):
    for i in range(1, n + 1):
        if queen_place(k, i):
            x[k] = i

            if k == n:
                print_solution()
            else:
                n_queen(k + 1)


def print_solution():
    print("Solution:")
    for i in range(1, n + 1):
        for j in range(1, n + 1):
            if x[i] == j:
                print("Q", end=" ")
            else:
                print(".", end=" ")
        print()
    print()


# Start N-Queen
n_queen(1)
